# ============================================================
# Order Agentique — .gitignore
# Angular 22 + Node.js + TypeScript + Mastra + Hono
# ============================================================

# Dependencies
node_modules/
**/node_modules/
.pnp/
.pnp.cjs

# Package manager / workspace caches
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Build output
dist/
**/dist/
out/
**/out/
build/
**/build/
coverage/
**/coverage/
.nx/
.angular/
.turbo/
.parcel-cache/
.svelte-kit/
.tmp/
temp/

# Angular / TypeScript caches
.angular/cache/
*.tsbuildinfo

# Test and coverage output
playwright-report/
test-results/
.nyc_output/
junit.xml

# Logs and diagnostic output
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
report.*.json

# Environment files and secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.test.example
!.env.development.example
!.env.production.example
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
!**/.env.test.example
!**/.env.development.example
!**/.env.production.example

# Private keys, certificates and credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
secrets/
credentials/
service-account*.json

# Local databases and generated data
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sqlite-journal
data/local/
storage/local/

# Runtime files
*.pid
*.pid.lock
pids/
*.seed
*.pidfile

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# IDEs and editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/*.code-snippets
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/

# OS-specific files
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Debugger / profiler output
*.stackdump
*.prof
*.heapsnapshot

# Local configuration overrides
*.local
*.local.*
config/local.*


